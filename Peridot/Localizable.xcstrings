    "error_network": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peridot ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach Peridot. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con Peridot. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Peridot. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere Peridot. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Peridot に接続できません。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Peridot。请检查网络连接后重试。"
          }
        }
      }
    },
    "google_on_web": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Google erstellte Konten können sich hier noch nicht anmelden. Nutze vorerst peridot.ai."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts created with Google can’t sign in here yet. Use peridot.ai for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas creadas con Google aún no pueden iniciar sesión aquí. Por ahora, usa peridot.ai."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes créés avec Google ne peuvent pas encore se connecter ici. Utilisez peridot.ai pour l’instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli account creati con Google non possono ancora accedere qui. Per ora usa peridot.ai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google で作成したアカウントは、まだここではログインできません。当面は peridot.ai をご利用ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 创建的账户暂时无法在此登录。目前请使用 peridot.ai。"
          }
        }
      }
    },
    "history_signed_out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Chats zu behalten und auf jedem Gerät weiterzumachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to keep your chats and pick them up again on any device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para guardar tus chats y retomarlos en cualquier dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour conserver vos chats et les retrouver sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per conservare le tue chat e riprenderle da qualsiasi dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインするとチャットが保存され、どのデバイスからでも続きを再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后即可保存聊天记录，并在任何设备上继续。"
          }
        }
      }
    },
