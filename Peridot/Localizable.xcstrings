    "invite_explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde, die sich über deinen Link anmelden, bekommen %1$@ Rabatt auf ihren ersten Monat. Wenn sie zum ersten Mal zahlen, bekommst du %2$@ Guthaben auf deiner Peridot-Rechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends who sign up with your link get %1$@ off their first month. When they first pay, you get %2$@ of credit on your Peridot bill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos que se registren con tu enlace obtienen un %1$@ de descuento en su primer mes. Cuando paguen por primera vez, recibes %2$@ de crédito en tu factura de Peridot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos amis qui s'inscrivent avec votre lien obtiennent %1$@ de réduction sur leur premier mois. Quand ils paient pour la première fois, vous recevez %2$@ de crédit sur votre facture Peridot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amici che si iscrivono con il tuo link ottengono il %1$@ di sconto sul primo mese. Quando pagano per la prima volta, ricevi %2$@ di credito sulla tua fattura Peridot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのリンクから登録した友達は最初の1か月が%1$@オフになります。友達が初めて支払うと、Peridotの請求に%2$@のクレジットが付与されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的链接注册的好友首月可享 %1$@ 折扣。他们首次付款后，你将获得 %2$@ 的 Peridot 账单抵扣额。"
          }
        }
      }
    },
