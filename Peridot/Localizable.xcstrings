    "payment_in_browser": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung öffnet sich auf der sicheren Stripe-Seite in deinem Browser. Kartendaten erreichen nie unsere Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment opens on Stripe's secure page in your browser. Card details never touch our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se abre en la página segura de Stripe en tu navegador. Los datos de la tarjeta nunca llegan a nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement s'ouvre sur la page sécurisée de Stripe dans votre navigateur. Les données de carte ne passent jamais par nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento si apre sulla pagina sicura di Stripe nel browser. I dati della carta non passano mai dai nostri server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いはブラウザでStripeの安全なページが開きます。カード情報が当社のサーバーに届くことはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款将在浏览器中的 Stripe 安全页面打开，卡信息不会经过我们的服务器。"
          }
        }
      }
    },
    "finish_payment": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Zahlung im Browser ab. Dein Plan wird automatisch aktiviert, wenn du zurückkommst."
