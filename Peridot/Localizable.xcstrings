    "effort_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Aufwand heißt längeres Nachdenken vor der Antwort. Dein Plan legt die höchste Stufe fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher effort thinks longer before answering. Your plan sets the highest level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con más esfuerzo, piensa más antes de responder. Tu plan fija el nivel máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un effort plus élevé réfléchit plus longtemps avant de répondre. Votre offre fixe le niveau maximal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con più impegno ragiona più a lungo prima di rispondere. Il tuo piano stabilisce il livello massimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強度を上げると、回答前により長く考えます。上限はプランによって決まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强度越高，回答前思考得越久。你的套餐决定最高级别。"
          }
        }
      }
    },
