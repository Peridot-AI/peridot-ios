    "consent_terms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich akzeptiere die Nutzungsbedingungen und habe die Datenschutzerklärung gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept the Terms of service and have read the Privacy policy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto los Términos del servicio y he leído la Política de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte les Conditions d'utilisation et j'ai lu la Politique de confidentialité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto i Termini di servizio e ho letto l'Informativa sulla privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約に同意し、プライバシーポリシーを読みました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我接受服务条款，并已阅读隐私政策。"
          }
        }
      }
    },
    "consent_immediate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verlange, dass mein Plan sofort beginnt, vor Ablauf der 14-tägigen Widerrufsfrist, und mir ist bewusst, dass ich mein Widerrufsrecht mit Beginn verliere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I ask for my plan to start right away, before the 14-day withdrawal period ends, and I understand that I lose my right of withdrawal once it starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pido que mi plan empiece de inmediato, antes de que termine el plazo de desistimiento de 14 días, y entiendo que pierdo mi derecho de desistimiento una vez que empiece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je demande que mon forfait commence immédiatement, avant la fin du délai de rétractation de 14 jours, et je comprends que je perds mon droit de rétractation dès qu'il commence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedo che il mio piano inizi subito, prima della fine del periodo di recesso di 14 giorni, e comprendo di perdere il diritto di recesso una volta iniziato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14日間のクーリングオフ期間の終了前にプランをすぐに開始することを求め、開始と同時に撤回権を失うことを理解しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我要求套餐立即开始（在 14 天撤回期结束前），并知悉一旦开始即失去撤回权。"
          }
        }
      }
    },
