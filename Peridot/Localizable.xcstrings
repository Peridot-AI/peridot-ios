    "google_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Google ist gerade nicht verfügbar. Versuche es erneut oder melde dich mit deiner E-Mail an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google sign-in isn’t available right now. Try again, or sign in with your email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con Google no está disponible ahora. Inténtalo de nuevo o inicia sesión con tu correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Google n’est pas disponible pour le moment. Réessayez ou connectez-vous avec votre e-mail."
