    "share_explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit dem Link kann diesen Chat im aktuellen Stand lesen. Spätere Nachrichten bleiben privat, bis du den Link aktualisierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can read this chat as it is now. Messages you send later stay private until you update the link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con el enlace puede leer este chat tal como está ahora. Los mensajes que envíes después seguirán siendo privados hasta que actualices el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut lire ce chat tel qu'il est maintenant. Les messages envoyés ensuite restent privés jusqu'à ce que vous mettiez le lien à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia il link può leggere questa chat così com'è ora. I messaggi inviati dopo restano privati finché non aggiorni il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを知っている人は誰でも、現在のこのチャットを読めます。後から送ったメッセージは、リンクを更新するまで非公開のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有链接的人都可以阅读此聊天的当前内容。之后发送的消息在你更新链接前保持私密。"
          }
        }
      }
    },
